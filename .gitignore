# Live catalogs / secrets at the repo root (and any accidental copies).
# Fixture trees under tools/screenshots/fixtures/ are tracked — they are
# fictional and required for the screenshot harness.
/bursts.json
/pins.json
/analysis.json
/inference_log.json
/inference_status.json
/integrations.json
/integrations_state.json
/retention_log.json
/alert_state.json
/events.jsonl
*.log
nohup.out
__pycache__/

# Pipeline / editor leftovers (tmp catalogs, dated .bak-* copies).
analysis.json.tmp.*
*.bak-*

# Old captures from the live cameras — never commit.
# User-guide shots from the synthetic fixture gallery live in docs/guide/img/.
/docs/img/

# The gallery is served from bind-mounts of /mnt/models/Webcam{21,22}.
# Those dirs are outside this repo and must never be git-added — the served
# index.html is the file ON THE MOUNT, not the repo working copy. Sync them
# with tools/deploy-webroot.sh; the pre-push hook verifies they match HEAD.
/mnt/models/
