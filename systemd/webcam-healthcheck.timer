[Unit]
Description=Periodic health check for the funes-vision nginx gallery
# Runs tools/webcam-healthcheck.sh every 60s. webcam-compose.service is
# Type=simple with Restart=always and owns the container's lifetime via
# tools/webcam-compose-run.sh (`compose up -d gallery` then `docker wait
# gallery`); this timer is the independent second line of defence for the
# case where the unit is alive but the container it waits on is dead.
After=webcam-compose.service docker.service
Wants=webcam-compose.service

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Persistent=true

[Install]
WantedBy=multi-user.target