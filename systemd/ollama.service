[Unit]
Description=Ollama local LLM server
RequiresMountsFor=__WEBCAM_MODELS_DIR__
After=network.target local-fs.target

# WEBCAM_OLLAMA_BIN and the OLLAMA_* runtime settings come from
# /etc/webcam/webcam.env (systemd/install.sh; see systemd/webcam.env.example).
# User=/Group=/HOME= are install-time tokens because systemd cannot expand
# environment variables there.
[Service]
EnvironmentFile=-/etc/webcam/webcam.env
Type=simple
User=__WEBCAM_USER__
Group=__WEBCAM_GROUP__
Environment=HOME=__WEBCAM_HOME__
ExecStart=__WEBCAM_OLLAMA_BIN__ serve
Restart=always
RestartSec=10
# Lowest CPU priority: inference soaks all 4 cores for ~5 min per
# image, everything else on the box should preempt it
Nice=19

[Install]
WantedBy=multi-user.target
