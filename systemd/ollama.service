[Unit]
Description=Ollama local LLM server (binary on /mnt/models)
After=network.target remote-fs.target

[Service]
Type=simple
User=user
Group=user
Environment=HOME=/home/user
Environment=OLLAMA_MODELS=/mnt/models/ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
ExecStart=/mnt/models/ollama-bin/bin/ollama serve
Restart=always
RestartSec=10
# Lowest CPU priority: inference soaks all 4 cores for ~5 min per
# image, everything else on the box should preempt it
Nice=19

[Install]
WantedBy=multi-user.target
