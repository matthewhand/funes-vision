# funes-vision host configuration (issue #48).
#
# Read by the systemd units via
#   EnvironmentFile=-/etc/webcam/webcam.env
# and by systemd/install.sh, which sources it (or generates it from the
# invoking user + checkout on first run). Copy to /etc/webcam/webcam.env and
# edit, or just run `sudo bash systemd/install.sh`.
#
# There are no baked-in accounts or home paths: every value below defaults
# from the user that runs install.sh.

# Service account that owns the pipeline processes. cv2/OpenCV must be
# importable by this user, otherwise create-index.sh dies with
# ModuleNotFoundError. Defaults to the install.sh invoking user.
WEBCAM_USER=webcam

# Primary group for WEBCAM_USER (defaults to that user's login group).
WEBCAM_GROUP=webcam

# Home directory of WEBCAM_USER (Ollama caches / app config live here).
WEBCAM_HOME=/home/webcam

# Absolute path to this checkout (repo root). Defaults to install.sh's repo.
WEBCAM_DIR=/opt/webcam

# Camera names to enable as webcam-pipeline@<name> units (space-separated).
WEBCAM_CAMERAS="Webcam21 Webcam22"

# Directory holding one image tree per camera (WEBCAM_DIR/%i is passed to
# create-index.sh as the camera dir).
WEBCAM_MODELS_DIR=/mnt/models

# Ollama binary. Point this at a standalone build, not the official
# installer, if you keep models off the root disk.
WEBCAM_OLLAMA_BIN=/usr/local/bin/ollama

# Ollama runtime settings. Ollama reads these names directly from the
# environment provided by EnvironmentFile.
OLLAMA_MODELS=/mnt/models/ollama/models
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=24h

# Browser origins allowed to WRITE to the API (pin/delete/settings/
# integrations/clip). Comma-separated, each one an exact
# scheme://host[:port] -- the value the browser puts in `Origin`, i.e. how the
# gallery is typed into the address bar. A trailing slash and upper case are
# normalized away; `*` and `null` are refused outright.
#
# YOU PROBABLY DO NOT NEED TO SET THIS.
#   * Behind the reverse proxy (nginx.conf proxies /api/ to :8190) the page and
#     the API are the SAME origin, so every write is accepted without any
#     allowlist entry at all. This is the recommended deployment.
#   * Opening the page directly on a camera container (:8180 front, :8280
#     back) makes the SPA point at http://<hostname>:8190, which is
#     cross-origin, so those origins DO have to be listed. The loopback forms
#     below cover http://localhost:8180 on this box; for LAN access from
#     another machine you must add the address *that machine* uses, which is
#     the box's LAN IP or hostname as the user types it, e.g.
#     http://192.168.1.50:8180,http://192.168.1.50:8280
#
# A misconfigured value fails closed and is reported at startup
# (journalctl -u webcam-api) -- do not paper over it with `*`, which allows
# nothing and reads like it allows everything. See #51.
WEBCAM_CORS_ORIGIN="http://localhost:8180,http://127.0.0.1:8180,http://localhost:8280,http://127.0.0.1:8280"
