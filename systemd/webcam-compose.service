[Unit]
Description=Webcam nginx gallery (docker compose)
# docker.service must be up and the data-root mount (/mnt/models) present
# before compose can start the bind-mounted gallery container. The daemon
# was historically 1.7 min late on boot because it had no ordering on the
# ext3 mount — without this the container dies on every reboot and nothing
# restarts it (restart: unless-stopped does not survive a daemon restart).
After=docker.service docker.socket network-online.target local-fs.target
Wants=docker.service docker.socket network-online.target

[Service]
# oneshot + RemainAfterExit: `docker compose up -d` returns immediately in
# detached mode, so a Type=simple unit would never reach "active" and
# Restart=always would re-run it every few seconds. oneshot reports active
# after the single successful start.
#
# Restart=on-failure covers the case where the command itself fails (daemon
# down, mount absent) — but NOT a container that dies after this unit has
# already exited cleanly. That gap is what took the gallery down for 2 hours:
# the unit kept reporting "active (exited)" while the container was dead.
# systemd/webcam-healthcheck.timer + tools/webcam-healthcheck.sh are the
# watchdog that actually notices a dead container and restarts it.
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
ExecStart=/usr/bin/docker compose -f /home/user/webcam/docker-compose.yml up -d webcam

[Install]
WantedBy=multi-user.target