[Unit]
Description=funes-vision nginx gallery (docker compose)
# docker.service must be up and the data-root mount (/mnt/models) present
# before compose can start the bind-mounted gallery container. The daemon
# was historically 1.7 min late on boot because it had no ordering on the
# ext3 mount — without this the container dies on every reboot and nothing
# restarts it (restart: unless-stopped does not survive a daemon restart).
After=docker.service docker.socket network-online.target local-fs.target
Wants=docker.service docker.socket network-online.target

[Service]
# Type=simple + Restart=always, owned by tools/webcam-compose-run.sh:
#   1. `docker compose up -d gallery` ensures the container exists (idempotent)
#   2. `exec docker wait gallery` blocks until it exits
#   3. on exit, Restart=always brings the whole thing back.
#
# The old unit was Type=oneshot: `compose up -d` returned immediately in
# detached mode, the unit reported "active (exited)", and a container that
# died an hour later was never noticed — the gallery was down for two hours
# while systemd thought the service was fine. A separate 60s healthcheck
# timer still catches that case, but it should not be the only thing
# standing between the gallery and downtime.
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=120
# WEBCAM_DIR comes from /etc/webcam/webcam.env, created by systemd/install.sh
# (see systemd/webcam.env.example). No User= here: docker needs root.
EnvironmentFile=-/etc/webcam/webcam.env
ExecStart=/usr/bin/bash ${WEBCAM_DIR}/tools/webcam-compose-run.sh

[Install]
WantedBy=multi-user.target
