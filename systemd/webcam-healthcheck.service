[Unit]
Description=Health check for the funes-vision nginx gallery
# One-shot wrapper for tools/webcam-healthcheck.sh. The timer fires it every
# 60s; the script exits 0 if the container is up and serving, and restarts
# it otherwise.
RequiresMountsFor=__WEBCAM_MODELS_DIR__
After=webcam-compose.service docker.service local-fs.target
EnvironmentFile=-/etc/webcam/webcam.env

[Service]
Type=oneshot
ExecStart=/usr/bin/bash ${WEBCAM_DIR}/tools/webcam-healthcheck.sh